# Mobile Auth Broker Configuration
# Copy this file to .env and fill in the values

# Required: GitHub OAuth App Client ID
GITHUB_CLIENT_ID=your-github-oauth-app-client-id

# Required: Server secret for token hashing (must be at least 32 bytes)
SERVER_SECRET=your-64-byte-random-secret-here

# Required: Broker hostname
BROKER_HOSTNAME=mobile.claw.example.org

# Required: Gateway service URL (in-cluster)
GATEWAY_SERVICE_URL=http://sctg-claw:18789

# Required: Comma-separated list of allowed emails
ALLOWED_EMAILS=user1@example.com,user2@example.com

# Optional: Token lifetimes
ACCESS_TOKEN_TTL=1h
REFRESH_TOKEN_TTL=720h

# Optional: Listen address
LISTEN_ADDR=:8080

# Optional: Database path
DATABASE_PATH=/data/broker.db

# Optional: Maximum WebSocket message size (16MB default)
MAX_MESSAGE_SIZE=16777216

# Optional: Poll interval scale factor
POLL_INTERVAL_SCALE=1.5
