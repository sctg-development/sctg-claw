{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
        "replicaCount": {
            "type": "integer",
            "default": 1
        },
        "image": {
            "type": "object",
            "properties": {
                "repository": {
                    "type": "string"
                },
                "tag": {
                    "type": "string"
                },
                "pullPolicy": {
                    "type": "string"
                }
            }
        },
        "imagePullSecrets": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "name": { "type": "string" }
                }
            }
        },
        "service": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string"
                },
                "port": {
                    "type": "integer",
                    "default": 18789
                }
            }
        },
        "openclaw": {
            "type": "object",
            "properties": {
                "existingSecret": {
                    "type": "string"
                },
                "secret": {
                    "type": "object",
                    "properties": {
                        "create": { "type": "boolean" },
                        "name": { "type": "string" },
                        "gatewayToken": {
                            "type": "string",
                            "description": "Required only when openclaw.config.gateway.auth.mode is token; mutually exclusive with trusted-proxy auth."
                        },
                        "gatewayPassword": {
                            "type": "string",
                            "description": "Optional local-callers password auth (OPENCLAW_GATEWAY_PASSWORD), coexists with gateway.auth.mode: trusted-proxy. Lets in-cluster CLI/kubectl-exec calls (openclaw devices approve, etc.) authenticate without going through the reverse proxy."
                        },
                        "mistralApiKeys": { "type": "string" },
                        "cohereApiKeys": { "type": "string" },
                        "poolsideApiKeys": { "type": "string" },
                        "exaApiKeys": { "type": "string" },
                        "firecrawlApiKeys": { "type": "string" },
                        "googlePlacesApiKeys": { "type": "string" } 
                    }
                },
                "config": {
                    "type": "object",
                    "description": "Freeform, rendered as-is into /home/node/.openclaw/openclaw.json. See the OpenClaw configuration reference for supported keys (gateway, agents, models, etc.).",
                    "additionalProperties": true
                },
                "workspaceFiles": {
                    "type": "object",
                    "description": "Workspace bootstrap files (AGENTS.md, SOUL.md, IDENTITY.md, USER.md) pre-seeded into /home/node/.openclaw/workspace/ by the init container on first boot. Existing files in the PVC are never overwritten (seed-if-missing). To reseed after changing values, delete the file from the PVC and restart the pod.",
                    "additionalProperties": {
                        "type": "string",
                        "description": "Markdown content for the named workspace file."
                    }
                },
                "initContainer": {
                    "type": "object",
                    "description": "Settings for the workspace-bootstrapper init container.",
                    "properties": {
                        "image": {
                            "type": "string",
                            "description": "Container image for the init container (default: busybox:1.37).",
                            "default": "busybox:1.37"
                        },
                        "resources": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "persistence": {
            "type": "object",
            "properties": {
                "enabled": { "type": "boolean" },
                "mountPath": { "type": "string" },
                "size": { "type": "string" },
                "storageClass": { "type": "string" },
                "accessModes": {
                    "type": "array",
                    "items": { "type": "string" }
                }
            }
        },
        "resources": {
            "type": "object",
            "additionalProperties": true
        },
        "livenessProbe": {
            "type": "object",
            "properties": {
                "enabled": { "type": "boolean" },
                "initialDelaySeconds": { "type": "integer" },
                "periodSeconds": { "type": "integer" },
                "timeoutSeconds": { "type": "integer" }
            }
        },
        "readinessProbe": {
            "type": "object",
            "properties": {
                "enabled": { "type": "boolean" },
                "initialDelaySeconds": { "type": "integer" },
                "periodSeconds": { "type": "integer" },
                "timeoutSeconds": { "type": "integer" }
            }
        },
        "cloudflared": {
            "type": "object",
            "description": "Optional cloudflared tunnel dependency (condition: cloudflared.enabled). Full key set is defined by the vendored cloudflared subchart; only the keys this parent chart reads directly are listed here.",
            "properties": {
                "enabled": { "type": "boolean" },
                "TunnelID": { "type": "string" },
                "credentials": {
                    "type": "object",
                    "additionalProperties": true
                },
                "cert": { "type": "string" },
                "config": {
                    "type": "string",
                    "description": "cloudflared config.yaml content. ingress[0].hostname is read back to populate gateway.controlUi.allowedOrigins."
                },
                "trustedProxies": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "CIDRs merged into openclaw.config.gateway.trustedProxies when cloudflared.enabled is true."
                }
            },
            "additionalProperties": true
        },
        "serviceAccount": {
            "type": "object",
            "properties": {
                "create": { "type": "boolean" },
                "name": { "type": "string" }
            }
        },
        "podAnnotations": {
            "type": "object",
            "additionalProperties": true
        },
        "podLabels": {
            "type": "object",
            "additionalProperties": true
        },
        "podSecurityContext": {
            "type": "object",
            "additionalProperties": true
        },
        "containerSecurityContext": {
            "type": "object",
            "additionalProperties": true
        },
        "nodeSelector": {
            "type": "object",
            "additionalProperties": true
        },
        "tolerations": {
            "type": "array",
            "items": { "type": "object" }
        },
        "affinity": {
            "type": "object",
            "additionalProperties": true
        },
        "oauth2-proxy": {
            "type": "object",
            "description": "Optional oauth2-proxy dependency (condition: oauth2-proxy.enabled). Full key set is defined by the vendored oauth2-proxy subchart; only the keys this parent chart's default values.yaml sets are listed here.",
            "properties": {
                "enabled": { "type": "boolean" },
                "ingress": {
                    "type": "object",
                    "additionalProperties": true
                },
                "config": {
                    "type": "object",
                    "properties": {
                        "clientID": { "type": "string" },
                        "clientSecret": { "type": "string" },
                        "cookieSecret": { "type": "string" },
                        "cookieName": { "type": "string" },
                        "configFile": { "type": "string" }
                    },
                    "additionalProperties": true
                }
            },
            "additionalProperties": true
        },
        "mobileAuthBroker": {
            "type": "object",
            "description": "Mobile authentication broker for GitHub Device Flow. Disabled by default.",
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "default": false,
                    "description": "Enable the mobile authentication broker."
                },
                "hostname": {
                    "type": "string",
                    "default": "mobile.claw.example.org",
                    "description": "The hostname for the mobile broker (e.g., mobile.claw.example.org)."
                },
                "image": {
                    "type": "object",
                    "properties": {
                        "repository": {
                            "type": "string",
                            "default": "sctg/mobile-auth-broker",
                            "description": "Docker image repository for the mobile auth broker."
                        },
                        "tag": {
                            "type": "string",
                            "default": "latest",
                            "description": "Docker image tag for the mobile auth broker."
                        },
                        "pullPolicy": {
                            "type": "string",
                            "default": "IfNotPresent",
                            "description": "Image pull policy."
                        }
                    }
                },
                "githubClientID": {
                    "type": "string",
                    "description": "GitHub OAuth App client ID. Required when enabled."
                },
                "serverSecret": {
                    "type": "string",
                    "description": "Server secret for token hashing. Must be at least 32 bytes. If not provided, a random one will be generated."
                },
                "gatewayServiceURL": {
                    "type": "string",
                    "description": "In-cluster OpenClaw Gateway service URL. Defaults to http://<release-name>:18789."
                },
                "allowedEmails": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "List of allowed email addresses for mobile authentication. Must match oauth2-proxy and gateway allow lists."
                },
                "accessTokenTTL": {
                    "type": "string",
                    "default": "1h",
                    "description": "Access token time-to-live (e.g., 1h, 30m)."
                },
                "refreshTokenTTL": {
                    "type": "string",
                    "default": "720h",
                    "description": "Refresh token time-to-live (e.g., 720h = 30 days)."
                },
                "maxMessageSize": {
                    "type": "integer",
                    "default": 16777216,
                    "description": "Maximum WebSocket message size in bytes (16MB default)."
                },
                "pollIntervalScale": {
                    "type": "number",
                    "default": 1.5,
                    "description": "Factor to increase polling interval on slow_down responses."
                },
                "service": {
                    "type": "object",
                    "properties": {
                        "type": {
                            "type": "string",
                            "default": "ClusterIP",
                            "description": "Service type for the mobile auth broker."
                        },
                        "port": {
                            "type": "integer",
                            "default": 8080,
                            "description": "Service port for the mobile auth broker."
                        }
                    }
                },
                "persistence": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean",
                            "default": true,
                            "description": "Enable persistence for the broker database."
                        },
                        "size": {
                            "type": "string",
                            "default": "1Gi",
                            "description": "Size of the persistent volume."
                        },
                        "storageClass": {
                            "type": "string",
                            "description": "Storage class for the persistent volume."
                        },
                        "accessModes": {
                            "type": "array",
                            "items": { "type": "string" },
                            "default": ["ReadWriteOnce"],
                            "description": "Access modes for the persistent volume."
                        },
                        "existingClaim": {
                            "type": "string",
                            "description": "Use an existing PVC instead of creating a new one."
                        }
                    }
                },
                "resources": {
                    "type": "object",
                    "additionalProperties": true,
                    "description": "Resource requests and limits for the mobile auth broker."
                },
                "livenessProbe": {
                    "type": "object",
                    "properties": {
                        "enabled": { "type": "boolean", "default": true },
                        "initialDelaySeconds": { "type": "integer", "default": 30 },
                        "periodSeconds": { "type": "integer", "default": 10 },
                        "timeoutSeconds": { "type": "integer", "default": 30 }
                    }
                },
                "readinessProbe": {
                    "type": "object",
                    "properties": {
                        "enabled": { "type": "boolean", "default": true },
                        "initialDelaySeconds": { "type": "integer", "default": 50 },
                        "periodSeconds": { "type": "integer", "default": 10 },
                        "timeoutSeconds": { "type": "integer", "default": 30 }
                    }
                },
                "containerSecurityContext": {
                    "type": "object",
                    "additionalProperties": true,
                    "description": "Security context for the mobile auth broker container."
                },
                "podSecurityContext": {
                    "type": "object",
                    "additionalProperties": true,
                    "description": "Security context for the mobile auth broker pod."
                },
                "serviceAccount": {
                    "type": "object",
                    "properties": {
                        "create": { "type": "boolean", "default": true },
                        "name": { "type": "string" }
                    }
                },
                "existingSecret": {
                    "type": "string",
                    "description": "Use an existing secret instead of creating a new one."
                },
                "secret": {
                    "type": "object",
                    "properties": {
                        "name": { "type": "string" },
                        "create": { "type": "boolean", "default": true }
                    }
                },
                "configMap": {
                    "type": "object",
                    "properties": {
                        "name": { "type": "string" },
                        "create": { "type": "boolean", "default": true }
                    }
                },
                "allowedEmailsConfigMap": {
                    "type": "object",
                    "properties": {
                        "name": { "type": "string" },
                        "create": { "type": "boolean", "default": true }
                    }
                },
                "ingress": {
                    "type": "object",
                    "properties": {
                        "enabled": { "type": "boolean", "default": false },
                        "annotations": {
                            "type": "object",
                            "additionalProperties": true
                        },
                        "tls": {
                            "type": "array",
                            "items": { "type": "object" }
                        }
                    }
                },
                "nodeSelector": {
                    "type": "object",
                    "additionalProperties": true
                },
                "tolerations": {
                    "type": "array",
                    "items": { "type": "object" }
                },
                "affinity": {
                    "type": "object",
                    "additionalProperties": true
                },
                "imagePullSecrets": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "name": { "type": "string" }
                        }
                    }
                }
            },
            "additionalProperties": false
        }
    }
}
